# Reads invoice photos sent from the admin page, using the host's `claude` login.
# Install as a user service (edit WorkingDirectory if the repo lives elsewhere):
#   ln -s "$PWD/deploy/quickmart-invoice-worker.service" ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now quickmart-invoice-worker
#   journalctl --user -u quickmart-invoice-worker -f
[Unit]
Description=QuickMart invoice photo reader (claude -p)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Dev/quickmart3
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env uv run --no-dev python -m app.services.supplier_invoices.worker --db data/quickmart.sqlite3
Restart=on-failure
RestartSec=30
# The worker finishes the upload it is reading before it stops; a cut-off upload is requeued on the next start.
TimeoutStopSec=900

[Install]
WantedBy=default.target
