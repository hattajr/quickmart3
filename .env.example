# Copy to .env.dev or .env.prod and replace every placeholder.
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
S3_ENDPOINT_URL=https://project.storage.supabase.co
BUCKET_NAME=public-image-bucket
PRODUCT_IMAGES_FOLDER=products
CAROUSEL_IMAGES_FOLDER=carousel
S3_REGION=ap-southeast-1

SQLITE_PATH=data/quickmart.sqlite3
APP_HOST=127.0.0.1
APP_PORT=8756
WORKERS=1
RELOAD=0
LOG_LEVEL=INFO
SESSION_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_COOKIE_SECURE=1

# Optional public payment/contact configuration.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_CONFIRMATION_PHONE=
PAYMENT_FEEDBACK_PHONE=

# Required when the monitoring profile is used.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-unique-password
